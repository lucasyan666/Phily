# Loaded by the Firebase CLI at deploy time and by the functions at runtime.
# Not secret: secrets live in Secret Manager (firebase functions:secrets:set).

# App Check stays off while the app is built with a free Apple team, which
# can't use App Attest. Delete this line before release.
ENFORCE_APP_CHECK=false

# The DeviceCheck trial check (claimTrial) needs a paid Apple team's key.
# Set the three APPLE_* secrets, then change this to true and redeploy.
DEVICECHECK_ENABLED=false
