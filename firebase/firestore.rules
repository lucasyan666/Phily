rules_version = '2';

// The app never talks to Firestore directly. Every read and write goes through
// the Cloud Functions in functions/src, which use the Admin SDK and so bypass
// these rules. Closing the database to clients entirely means a leaked config
// (GoogleService-Info.plist ships inside every copy of the app) can't be used
// to read anyone's feedback or email address, or to write around the
// functions' validation and rate limits.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
